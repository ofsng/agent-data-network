{
  "name": "agent-data-network",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "start": "bash scripts/start.sh",
    "demo": "tsx src/cli.ts demo",
    "test": "bash scripts/test-all.sh",
    "test:anchor": "ts-mocha -p ./tsconfig.json -t 1000000 'tests/anchor/**/*.ts'",
    "test:app": "ts-mocha -p ./tsconfig.json -t 1000000 'tests/app/**/*.ts'",
    "test:ui": "tsx scripts/ui-smoke.ts",
    "cli": "tsx src/cli.ts",
    "server": "tsx src/api/server.ts",
    "verify": "tsx scripts/verify-evidence.ts",
    "mcp": "tsx src/mcp/server.ts",
    "devnet": "bash scripts/devnet.sh",
    "start:devnet": "(fuser -k 8787/tcp 2>/dev/null || true) && SOLANA_CLUSTER=devnet tsx src/api/server.ts",
    "verify:devnet": "SOLANA_CLUSTER=devnet tsx scripts/verify-evidence.ts",
    "export:public": "SOLANA_CLUSTER=devnet tsx scripts/export-public.ts",
    "connect": "tsx src/cli.ts connect"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "better-sqlite3": "13.2.0",
    "bs58": "6.0.0",
    "tweetnacl": "1.0.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.7",
    "chai": "4.5.0",
    "mocha": "10.8.2",
    "playwright-core": "1.65.1",
    "ts-mocha": "10.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
